# ==============================================================================
# SABOOT Suite — Environment Configuration Example (.env.example)
# ==============================================================================
# NOTE: Never commit actual secret keys or credentials to version control.
# Copy this file to `.env` or `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------

# Optional: Supabase project URL for multi-device realtime phone-pairing companion
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional: Supabase anonymous public key for realtime phone pairing
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Optional: Dynamic Plan Pricing Overrides (in INR ₹; sensible defaults: Starter 349/2499, ClaimRadar 599/4499, Warehouse 1199/8999)
# Can be changed without code edits; annualStrike, daily cost, and savings% recalculate automatically
VITE_PRICE_STARTER_MONTHLY="349"
VITE_PRICE_STARTER_ANNUAL="2499"
VITE_PRICE_CLAIMRADAR_MONTHLY="599"
VITE_PRICE_CLAIMRADAR_ANNUAL="4499"
VITE_PRICE_WAREHOUSE_MONTHLY="1199"
VITE_PRICE_WAREHOUSE_ANNUAL="8999"

# Razorpay Payment Link (https://razorpay.com/docs/payments/payment-links/)
# If VITE_PAYMENT_LINK is not set, the payment button is hidden and "Contact support to buy" (WhatsApp) is shown.
VITE_PAYMENT_LINK="https://rzp.io/l/your_payment_link_placeholder"

# Optional per-plan payment link overrides
VITE_PAYMENT_LINK_STARTER="https://rzp.io/l/starter_plan_placeholder"
VITE_PAYMENT_LINK_CLAIMRADAR="https://rzp.io/l/claimradar_plan_placeholder"
VITE_PAYMENT_LINK_WAREHOUSE="https://rzp.io/l/warehouse_plan_placeholder"

# Backward-compatible Razorpay payment link aliases
VITE_RAZORPAY_PAYMENT_URL="https://rzp.io/l/your_payment_link_placeholder"
VITE_RAZORPAY_PAYMENT_URL_STARTER="https://rzp.io/l/starter_plan_placeholder"
VITE_RAZORPAY_PAYMENT_URL_CLAIMRADAR="https://rzp.io/l/claimradar_plan_placeholder"
VITE_RAZORPAY_PAYMENT_URL_WAREHOUSE="https://rzp.io/l/warehouse_plan_placeholder"

# Dedicated WhatsApp Support Number for "Contact support to buy" fallback link
VITE_SUPPORT_WHATSAPP_NUMBER="+919876543210"

# Verified Merchant VPA for manual UPI QR generation
# NOTE: In production builds, placeholder addresses (saboot@upi, claimproof@upi) are strictly removed
# and the app will never display a QR for placeholder addresses (https://razorpay.com/docs/payments/payment-methods/upi/).
VITE_SABOOT_VPA=""
VITE_PAYMENT_VPA=""

# Optional: Privacy-friendly opt-in analytics endpoint (Plausible / self-hostable ingest)
# Never sends personal data, AWBs, order IDs, SKUs, or file names (needs verification)
VITE_ANALYTICS_ENDPOINT="https://analytics.example.com/api/event"

# Optional: Error monitoring ingest endpoint (Sentry / GlitchTip)
# All AWBs, order IDs, SKUs, and local paths are scrubbed client-side before sending (needs verification)
VITE_ERROR_MONITORING_ENDPOINT="https://o0.ingest.sentry.io/api/0000000/envelope/"
VITE_SENTRY_DSN="https://publicKey@o0.ingest.sentry.io/0000000"


# ------------------------------------------------------------------------------
# Backend & Supabase Edge Functions (e.g. razorpay-webhook)
# ------------------------------------------------------------------------------

# Razorpay Webhook Secret (from Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Supabase Service Role Key (for Edge Functions to update license tables)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# ES256 License Private Key (Base64-encoded JWK generated via `npm run gen:keys`)
# Never expose this private key to the client browser.
LICENSE_SIGNING_KEY_JWK_B64="eyJraWQiOiJjcC1kZXYtMSIsImt0eSI6IkVDIiwiY3J2IjoiUC0yNTYi...placeholder"

# License Key Identifier (must match LICENSE_JWT_KID in src/lib/licenseKeys.ts)
LICENSE_JWT_KID="cp-dev-1"

