{
  "manifest_version": 3,
  "name": "SABOOT: Shipping Label & Packing Proof Studio",
  "short_name": "SABOOT",
  "version": "1.0.0",
  "description": "Local-first shipping label thermal organizer, barcode-verified packing proof recorder, and dispute evidence studio.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open SABOOT Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": []
}

