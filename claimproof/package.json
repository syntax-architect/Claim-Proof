{
  "name": "saboot-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SABOOT.in — local-first SmartLabel SKU+ label cropper & SABOOT AWB barcode-verified packing-video proof studio for Indian e-commerce sellers.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.cjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check src",
    "format:fix": "prettier --write src",
    "test": "vitest run",
    "test:build": "node scripts/check_no_demo.mjs",
    "test:e2e": "playwright test",
    "test:supabase": "vitest run supabase/functions",
    "audit:seo": "node scripts/audit_site_seo.mjs",
    "stress": "node scripts/stress_runner.mjs",
    "stress:ci": "node scripts/stress_runner.mjs --ci",
    "stress:labels": "node scripts/generate_stress_labels.mjs",
    "stress:scans": "node scripts/stress_barcode_scans.mjs",
    "stress:video": "node scripts/stress_video.mjs",
    "check:palette": "node scripts/check_palette.mjs",
    "check": "npm run check:palette && npm run typecheck && npm run lint && npm test && npm run build",
    "build:extension": "node scripts/build_extension.mjs",
    "gen:icons": "python scripts/gen_icons.py",
    "gen:keys": "node scripts/gen_license_keys.mjs",
    "gen:samples": "node scripts/make_sample_labels.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@zxing/library": "0.23.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "framer-motion": "14.9.0",
    "lucide-react": "1.66.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/jest-axe": "3.5.9",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "jest-axe": "11.0.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.6.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
