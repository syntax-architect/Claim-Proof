---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label="SABOOT Home">
          <img
            src="/logo.svg"
            alt="SABOOT Logo"
            width="156"
            height="41"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p>
          Local-first shipping proof studio for Indian marketplace sellers shipping on Meesho, Flipkart, Amazon, Myntra, and AJIO.
        </p>
        <p style="margin-top: 0.75rem; font-size: 0.8rem; color: #34d399; display: flex; align-items: center; gap: 0.4rem;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>100% Offline-First · Zero Cloud Uploads · Hardware Vault</span>
        </p>
      </div>

      <div class="footer-group">
        <h4>Product</h4>
        <ul class="footer-links">
          <li><a href="/features">Features & Modules</a></li>
          <li><a href="/pricing">Pricing & Plans</a></li>
          <li><a href="/guides">SOP Guides</a></li>
          <li><a href="/faq">Frequently Asked Questions</a></li>
        </ul>
      </div>

      <div class="footer-group">
        <h4>Company</h4>
        <ul class="footer-links">
          <li><a href="/about">About SABOOT</a></li>
          <li><a href="/contact">Contact & Support</a></li>
          <li><a href="https://app.saboot.in" target="_blank" rel="noopener noreferrer">Launch Web App</a></li>
        </ul>
      </div>

      <div class="footer-group">
        <h4>Legal & Trust</h4>
        <ul class="footer-links">
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="/refund">Refund Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} SABOOT.in. All rights reserved.</p>
      <p style="font-size: 0.8rem;">
        Amazon, Flipkart, Meesho, Myntra, and AJIO are trademarks of their respective owners. SABOOT is an independent desktop utility.
      </p>
    </div>
  </div>
</footer>
