---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "404 — Page Not Found | SABOOT";
const description = "The page you are looking for does not exist or has been moved. Explore SABOOT features, pricing, and guides.";
---

<BaseLayout title={title} description={description}>
  <div class="container not-found-page">
    <span class="error-badge">404 Error</span>
    <h1>Page Not Found</h1>
    <p>
      The link you followed may be broken or the page may have been moved. Let's get you back to the packing station.
    </p>

    <div style="display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">
        Return to Home
      </a>
      <a href="/features" class="btn btn-secondary">
        Explore Features
      </a>
      <a href="/pricing" class="btn btn-secondary">
        View Pricing
      </a>
      <a href="/guides" class="btn btn-secondary">
        Read Guides
      </a>
    </div>

    <div style="margin-top: 3rem; font-size: 0.9rem; color: var(--color-text-subtle);">
      Need help? Reach our team at <a href="mailto:support@saboot.in">support@saboot.in</a>
    </div>
  </div>
</BaseLayout>
